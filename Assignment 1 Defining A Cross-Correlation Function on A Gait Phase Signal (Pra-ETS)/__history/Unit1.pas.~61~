unit Unit1;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, VclTee.TeeGDIPlus, Vcl.ComCtrls,
  Vcl.StdCtrls, VCLTee.TeEngine, VCLTee.Series, Vcl.ExtCtrls, VCLTee.TeeProcs,
  VCLTee.Chart, Vcl.Buttons, System.Math;

type
  TForm1 = class(TForm)
    btnInputData: TButton;
    btnCompute: TButton;
    bitbtnExit: TBitBtn;
    OpenDialog1: TOpenDialog;
    ChartGait: TChart;
    PageControlResults: TPageControl;
    TabAutocorr: TTabSheet;
    TabCrosscorr: TTabSheet;
    TabNormalization: TTabSheet;
    ListBoxAutoCorr: TListBox;
    SeriesHeel: TLineSeries;
    SeriesToe: TLineSeries;
    ListBoxCrossCorr: TListBox;
    ChartCrossCorr: TChart;
    SeriesCrossCorr: TLineSeries;
    ListBoxNorm: TListBox;
    ChartNorm: TChart;
    SeriesNorm: TLineSeries;
    TrackBarLag: TTrackBar;
    EditLag: TEdit;
    lblLag: TLabel;
    SeriesToeShifted: TLineSeries;
    ButtonClear: TButton;
    TabShiftedAutocorr: TTabSheet;
    ListBoxShiftedAutoCorr: TListBox;
    TabShiftedCrossCorr: TTabSheet;
    ListBoxShiftedCrossCorr: TListBox;
    TabShiftedNormalization: TTabSheet;
    ListBoxShiftedNorm: TListBox;
    ChartShiftedCrossCorr: TChart;
    ChartShiftedNorm: TChart;
    SeriesShiftedCrossCorr: TLineSeries;
    SeriesShiftedNorm: TLineSeries;
    procedure btnInputDataClick(Sender: TObject);
    procedure btnComputeClick(Sender: TObject);
    procedure TrackBarLagChange(Sender: TObject);
    procedure ButtonClearClick(Sender: TObject);
    procedure bitbtnExitClick(Sender: TObject);
