{ TComplex }

constructor TComplex.Create(ARe, AIm: Double);
begin
  Re := ARe;
  Im := AIm;
end;

class operator TComplex.Add(const a, b: TComplex): TComplex;
begin
  Result.Re := a.Re + b.Re;
  Result.Im := a.Im + b.Im;
end;

class operator TComplex.Subtract(const a, b: TComplex): TComplex;
begin
  Result.Re := a.Re - b.Re;
  Result.Im := a.Im - b.Im;
end;

class operator TComplex.Multiply(const a, b: TComplex): TComplex;
begin
  Result.Re := a.Re * b.Re - a.Im * b.Im;
  Result.Im := a.Re * b.Im + a.Im * b.Re;
end;

class operator TComplex.Divide(const a, b: TComplex): TComplex;
var
  denom: Double;
begin
  denom := Sqr(b.Re) + Sqr(b.Im);
  if denom = 0 then
  begin
    Result.Re := 0;
    Result.Im := 0;
  end
  else
  begin
    Result.Re := (a.Re * b.Re + a.Im * b.Im) / denom;
    Result.Im := (a.Im * b.Re - a.Re * b.Im) / denom;
  end;
end;

function TComplex.GetMagnitude: Double;
begin
  Result := Sqrt(Sqr(Re) + Sqr(Im));
end;

procedure TForm1.btnLoadSignalClick(Sender: TObject);
var
  SignalFile: TStringList;
  i: Integer;
  line: string;
  parts: TArray<string>;
begin
  if FileOpenDialog.Execute then
  begin
    SetLength(x, 0);
    chartOriginalSignal.Series[0].Clear;
    lbAutocorrelation.Clear;
    sgRxxMatrix.RowCount := 1;
    sgRxxMatrix.ColCount := 1;
    sgInverseMatrix.RowCount := 1;
    sgInverseMatrix.ColCount := 1;
    lbCoefficients.Clear;
    chartErrorSignal.Series[0].Clear;
    chartReconstructedSignal.Series[0].Clear;
    chartComparison.Series[0].Clear;
    if chartComparison.SeriesCount > 2 then chartComparison.Series[2].Clear;
    if chartComparison.SeriesCount > 1 then chartComparison.Series[1].Clear;
    lbMSEValues.Clear;
    lblFinalMSE.Caption := 'MSE: -';
    chartMSE.Series[0].Clear;

    SignalFile := TStringList.Create;
    try
      SignalFile.LoadFromFile(FileOpenDialog.FileName);
      Ndata := SignalFile.Count;
      SetLength(x, Ndata);
      for i := 0 to Ndata - 1 do
      begin
        line := SignalFile[i];
        parts := line.Split([#9]);
        if Length(parts) = 2 then
          x[i] := StrToFloat(parts[1]);
      end;
    finally
      SignalFile.Free;
    end;

    for i := 0 to Ndata - 1 do
    begin
      chartOriginalSignal.Series[0].AddXY(i, x[i]);
    end;

    lblSignalInfo.Caption := Format('Loaded %d data points from %s', [Ndata, ExtractFileName(FileOpenDialog.FileName)]);
    ShowMessage('Signal loaded. Please proceed to step 2.');
    PageControl1.ActivePageIndex := 0;
  end;
end;

procedure TForm1.btnCalcAutocorrClick(Sender: TObject);
var
  l, n: Integer;
  sum: Double;
begin
  if Length(x) = 0 then
  begin
    ShowMessage('Please load a signal first (Step 1).');
    Exit;
  end;

  try
    P := StrToInt(edtTimeLag.Text);
    if (P <= 0) or (P >= Ndata) then
    begin
      ShowMessage('Time Lag must be a positive integer less than data points.');
      Exit;
    end;
  except
    ShowMessage('Invalid value for Time Lag.');
    Exit;
  end;

  SetLength(rxx, P + 1);
  lbAutocorrelation.Clear;

  for l := 0 to P do
  begin
    sum := 0.0;
    for n := 0 to Ndata - 1 do
    begin
      if (n - l) >= 0 then
        sum := sum + x[n] * x[n - l];
    end;
    rxx[l] := sum;
    lbAutocorrelation.Items.Add(Format('rxx[%d] = %f', [l, rxx[l]]));
  end;

  ShowMessage('Autocorrelation complete. Please proceed to step 3.');
  PageControl1.ActivePageIndex := 1;
end;


procedure TForm1.btnBuildMatrixClick(Sender: TObject);
var
  i, j: Integer;
begin
  if Length(rxx) = 0 then
  begin
    ShowMessage('Please calculate autocorrelation first (Step 2).');
    Exit;
  end;

  SDLMatrix1.Resize(P, P);
  sgRxxMatrix.ColCount := P;
  sgRxxMatrix.RowCount := P;

  for i := 1 to P do
  begin
    for j := 1 to P do
    begin
      SDLMatrix1.Elem[i, j] := rxx[Abs((i - 1) - (j - 1))];
      sgRxxMatrix.Cells[j-1, i-1] := FloatToStr(SDLMatrix1.Elem[i, j]);
    end;
  end;

  ShowMessage('Rxx Matrix built. Please proceed to step 4.');
  PageControl1.ActivePageIndex := 2;
end;

procedure TForm1.btnCalcCoeffsClick(Sender: TObject);
var
  i, k: Integer;
  HasilKaliMatrik: Double;
begin
  {if (SDLMatrix1.Rows = 0) then
  begin
    ShowMessage('Please build the Rxx matrix first (Step 3).');
    Exit;
  end;}

  try
    SDLMatrix1.Invert;
  except
    on E: Exception do
    begin
      ShowMessage('Matrix inversion failed: ' + E.Message);
      Exit;
    end;
  end;

  sgInverseMatrix.ColCount := P;
  sgInverseMatrix.RowCount := P;
  for i := 1 to P do
    for k := 1 to P do
    begin
      sgInverseMatrix.Cells[k-1, i-1] := FloatToStr(SDLMatrix1.Elem[i, k]);
    end;

  SDLMatrix2.Resize(1, P);

  SetLength(a_coeffs, P + 1);
  lbCoefficients.Clear;

  for i := 1 to P do
  begin
    HasilKaliMatrik := 0;
    for k := 1 to P do
    begin
      HasilKaliMatrik := HasilKaliMatrik + (SDLMatrix1.Elem[k, i] * rxx[k]);
    end;
    a_coeffs[i] := HasilKaliMatrik;
    lbCoefficients.Items.Add(Format('a[%d] = %f', [i, a_coeffs[i]]));
  end;

  ShowMessage('Predictor coefficients calculated. Please proceed to step 5.');
  PageControl1.ActivePageIndex := 3;
end;

procedure TForm1.btnInverseFilterClick(Sender: TObject);
var
  m, k: Integer;
  x_hat: Double;
  a_inv: TArray<Double>;
begin
  if Length(a_coeffs) = 0 then
  begin
    ShowMessage('Please calculate coefficients first (Step 4).');
    Exit;
  end;

  SetLength(a_inv, P + 1);
  for k := 1 to P do
  begin
    a_inv[k] := -a_coeffs[k];
  end;

  SetLength(e_signal, Ndata);
  chartErrorSignal.Series[0].Clear;
  chartComparison.Series[2].Title := 'Excitation e(m)';
  chartComparison.Series[2].Clear;

  for m := 0 to Ndata - 1 do
  begin
    x_hat := 0.0;
    for k := 1 to P do
    begin
      if (m - k) >= 0 then
      begin
        x_hat := x_hat + (a_inv[k] * x[m - k]);
      end;
    end;
    e_signal[m] := x[m] + x_hat;
    chartErrorSignal.Series[0].AddXY(m, e_signal[m]);
    chartComparison.Series[2].AddXY(m, e_signal[m]);
  end;

  ShowMessage('Error signal e(m) generated. Please proceed to step 6.');
  PageControl1.ActivePageIndex := 4;
end;

procedure TForm1.btnCalcFreqResponseClick(Sender: TObject);
  // Helper functions for the root-finding algorithm
  function EvaluatePolynomial(const coeffs: TArray<TComplex>; const z: TComplex): TComplex;
  var
    i: Integer;
    res: TComplex;
  begin
    res := TComplex.Create(0, 0);
    for i := High(coeffs) downto 0 do
    begin
      res := res * z + coeffs[i];
    end;
    Result := res;
  end;

  function DifferentiatePolynomial(const coeffs: TArray<TComplex>): TArray<TComplex>;
  var
    i: Integer;
    res: TArray<TComplex>;
  begin
    SetLength(res, Length(coeffs) - 1);
    for i := 1 to High(coeffs) do
    begin
      res[i - 1] := TComplex.Create(coeffs[i].Re * i, coeffs[i].Im * i);
    end;
    Result := res;
  end;

  function DeflatePolynomial(const coeffs: TArray<TComplex>; const root: TComplex): TArray<TComplex>;
  var
    i: Integer;
    b: TArray<TComplex>;
  begin
    SetLength(b, Length(coeffs) - 1);
    b[High(b)] := coeffs[High(coeffs)];
    for i := High(b) - 1 downto 0 do
    begin
      b[i] := coeffs[i+1] + root * b[i+1];
    end;
    Result := b;
  end;

var
  G, sse_error, mse_error: Double;
  sum_cos, sum_sin, angle, denominator_real, denominator_imag,
  denominator_magnitude, H_magnitude: Double;
  i, k, NumFreqPoints, iter, MaxIterations: Integer;
  f, angle_circle, Epsilon: Double;
  poly, poly_deriv, current_poly: TArray<TComplex>;
  z_guess, z_next, fz, fz_deriv: TComplex;
  root: TComplex;
  RealRoots, ImagRoots: TArray<Double>;
begin
  if (Length(a_coeffs) = 0) or (Length(e_signal) = 0) then
  begin
    ShowMessage('Please calculate coefficients and error signal first (Steps 4 & 5).');
    Exit;
  end;

  // Frequency Response Calculation
  sse_error := 0.0;
  for i := 0 to Ndata - 1 do sse_error := sse_error + Sqr(e_signal[i]);
  if Ndata > 0 then mse_error := sse_error / Ndata else mse_error := 0.0;
  G := Sqrt(mse_error);
  lblGainG.Caption := Format('Gain (G): %f', [G]);

  chartFreqResponse.Series[0].Clear;
  NumFreqPoints := 1000;
  for i := 1 to NumFreqPoints do
  begin
    f := NumFreqPoints;
    sum_cos := 0.0; sum_sin := 0.0;
    for k := 1 to P do
    begin
      angle := 2 * Pi * k * f;
      sum_cos := sum_cos + a_coeffs[k] * Cos(angle);
      sum_sin := sum_sin + a_coeffs[k] * Sin(angle);
    end;
    denominator_real := 1 - sum_cos;
    denominator_imag := sum_sin;
    denominator_magnitude := Sqrt(Sqr(denominator_real) + Sqr(denominator_imag));
    if denominator_magnitude > 1E-9 then H_magnitude := G / denominator_magnitude else H_magnitude := 0;
    chartFreqResponse.Series[0].AddXY(f, H_magnitude);
  end;

  // Pole-Zero Calculation
  SetLength(poly, P + 1);
  poly[P] := TComplex.Create(1, 0);
  for i := 1 to P do
    poly[P - i] := TComplex.Create(-a_coeffs[i], 0);

  SetLength(RealRoots, P);
  SetLength(ImagRoots, P);
  current_poly := poly;
  MaxIterations := 100;
  Epsilon := 1E-9;

  for i := 0 to P - 1 do
  begin
    z_guess := TComplex.Create(0.4, 0.9);
    poly_deriv := DifferentiatePolynomial(current_poly);
    for iter := 1 to MaxIterations do
    begin
      fz := EvaluatePolynomial(current_poly, z_guess);
      fz_deriv := EvaluatePolynomial(poly_deriv, z_guess);
      if fz_deriv.Magnitude < Epsilon then Break;
      z_next := z_guess - (fz / fz_deriv);
      if (z_next - z_guess).Magnitude < Epsilon then
      begin
        z_guess := z_next;
        Break;
      end;
      z_guess := z_next;
    end;
    root := z_guess;
    RealRoots[i] := root.Re;
    ImagRoots[i] := root.Im;
    if Length(current_poly) > 1 then
      current_poly := DeflatePolynomial(current_poly, root);
  end;

  chartPoleZero.Series[0].Clear;
  chartPoleZero.Series[1].Clear;
  chartPoleZero.Title.Text.Clear;
  //chartPoleZero.Title.Add('Pole-Zero Plot');

  for i := 0 to 100 do
  begin
    angle_circle := i * 2 * Pi / 100;
    chartPoleZero.Series[1].AddXY(Cos(angle_circle), Sin(angle_circle));
  end;

  for i := 0 to P - 1 do
  begin
    chartPoleZero.Series[0].AddXY(RealRoots[i], ImagRoots[i]);
  end;

  ShowMessage('Frequency response and Pole-Zero map calculated. Please proceed to step 7.');
  PageControl1.ActivePageIndex := 5;
end;

procedure TForm1.btnReconstructClick(Sender: TObject);
var
  m, k: Integer;
  sum2: Double;
begin
  if Length(e_signal) = 0 then
  begin
    ShowMessage('Please generate the error signal first (Step 5).');
    Exit;
  end;

  SetLength(x_new, Ndata);
  chartReconstructedSignal.Series[0].Clear;

  for m := 0 to Ndata - 1 do
  begin
    sum2 := 0.0;
    for k := 1 to P do
    begin
      if (m - k) >= 0 then
      begin
        sum2 := sum2 + a_coeffs[k] * x[m - k];
      end;
    end;
    x_new[m] := sum2 + e_signal[m];
    chartReconstructedSignal.Series[0].AddXY(m, x_new[m]);
  end;

  ShowMessage('Prediction signal reconstructed. Please proceed to step 8.');
  PageControl1.ActivePageIndex := 6;
end;


procedure TForm1.btnCompareClick(Sender: TObject);
var
  i: Integer;
begin
  if (Length(x) = 0) or (Length(x_new) = 0) then
  begin
    ShowMessage('Please load and reconstruct the signal first.');
    Exit;
  end;

  chartComparison.Series[0].Clear;
  chartComparison.Series[1].Clear;
  chartComparison.Series[0].Title := 'Original (x_old)';
  chartComparison.Series[1].Title := 'Reconstructed (x_new)';

  for i := 0 to Ndata - 1 do
  begin
    chartComparison.Series[0].AddXY(i, x[i]);
    chartComparison.Series[1].AddXY(i, x_new[i]);
  end;

  PageControl1.ActivePageIndex := 7;
end;

procedure TForm1.btnCalcMSEClick(Sender: TObject);
var
  m: Integer;
  sse, mse: Double;
begin
  if (Length(x) = 0) or (Length(x_new) = 0) then
  begin
    ShowMessage('Please compare the signals first (Step 8).');
    Exit;
  end;

  SetLength(error_model, Ndata);
  sse := 0.0;
  lbMSEValues.Clear;
  chartMSE.Series[0].Clear;

  for m := 0 to Ndata - 1 do
  begin
    error_model[m] := Abs(x[m] - x_new[m]);
    chartMSE.Series[0].AddXY(m, error_model[m]);
    lbMSEValues.Items.Add(Format('err_model[%d] = %g', [m, error_model[m]]));
  end;

  sse := 0.0;
  for m := 0 to Ndata - 1 do
  begin
    sse := sse + Sqr(x[m] - x_new[m]);
  end;

  if Ndata > 0 then
  begin
    mse := (1 / Ndata) * sse;
  end
  else
  begin
    mse := 0.0;
  end;

  lblFinalMSE.Caption := Format('Final Mean Squared Error (MSE): %g', [mse]);
  ShowMessage('MSE calculation complete.');
  PageControl1.ActivePageIndex := 8;
end;


